# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/SnippetBox

# JWT secret for token signing (minimum 32 characters, use a random string)
JWT_SECRET=your_strong_random_secret_here

# Client URL for CORS (comma-separated for multiple origins in production)
CLIENT_URL=http://localhost:5173

# Server port
PORT=3001

# Node environment: development | production | test
NODE_ENV=development
